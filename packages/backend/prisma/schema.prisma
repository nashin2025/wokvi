// Prisma Schema for Wokvi (SQLite compatible)
// Run `pnpm db:generate` after changes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String    @map("password_hash")
  avatar        String?
  role          String    @default("USER")
  preferences   String    @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projects      Project[]
  collaborations Collaboration[]
  classrooms    Classroom[] @relation("TeacherClassrooms")
  enrollments   ClassroomStudent[] @relation("StudentEnrollments")
  assignments   Assignment[] @relation("TeacherAssignments")
  submissions   AssignmentSubmission[]

  @@map("users")
}

model Project {
  id              String    @id @default(cuid())
  name            String
  description     String?
  mode            String    @default("MAGIC")
  board           String    @default("ESP32_DEVKIT")
  components      String    @default("[]")
  wires           String    @default("[]")
  code            String    @default("")
  simulationConfig String   @default("{}") @map("simulation_config")
  isPublic        Boolean   @default(false) @map("is_public")
  tags            String    @default("[]")
  ownerId         String    @map("owner_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators   Collaboration[]
  versions        ProjectVersion[]

  @@map("projects")
}

model Collaboration {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("EDITOR")
  joinedAt  DateTime @default(now()) @map("joined_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("collaborations")
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  version   Int
  data      String
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_versions")
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacherId   String   @map("teacher_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacher     User     @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  students    ClassroomStudent[]
  assignments Assignment[]

  @@map("classrooms")
}

model ClassroomStudent {
  id          String   @id @default(cuid())
  classroomId String   @map("classroom_id")
  userId      String   @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at")
  progress    String   @default("{}")

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User     @relation("StudentEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@unique([classroomId, userId])
  @@map("classroom_students")
}

model Assignment {
  id              String   @id @default(cuid())
  classroomId     String   @map("classroom_id")
  title           String
  description     String?
  starterProjectId String?  @map("starter_project_id")
  expectedBehavior String   @default("[]") @map("expected_behavior")
  dueDate         DateTime? @map("due_date")
  maxScore        Int      @default(100) @map("max_score")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  classroom       Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  submissions     AssignmentSubmission[]
  teacher         User      @relation("TeacherAssignments", fields: [teacherId], references: [id])
  teacherId       String   @map("teacher_id")

  @@map("assignments")
}

model AssignmentSubmission {
  id            String   @id @default(cuid())
  assignmentId  String   @map("assignment_id")
  studentId     String   @map("student_id")
  projectData   String   @map("project_data")
  simulationLog String?  @map("simulation_log")
  score         Float?
  feedback      String?
  status        String   @default("NOT_STARTED")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  gradedAt      DateTime? @map("graded_at")

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       ClassroomStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [studentId], references: [id])

  @@map("assignment_submissions")
}

model Component {
  id          String   @id @default(cuid())
  type        String
  name        String
  category    String
  pins        String
  footprint   String
  simulationModel String? @map("simulation_model")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("components")
}

model SimulationSession {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  status    String   @default("STOPPED")
  config    String
  logs      String   @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("simulation_sessions")
}