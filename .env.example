# Wokvi Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Backend
# ============================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wokvi

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ============================================
# Frontend
# ============================================

VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# ============================================
# AI Services (Optional - for AI features)
# ============================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# ============================================
# Deployment (Fly.io, Vercel, etc.)
# ============================================

# Fly.io
FLY_API_TOKEN=

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wokvi-assets

# ============================================
# Monitoring (Optional)
# ============================================

# Sentry
SENTRY_DSN=

# Logtail
LOGTAIL_SOURCE_TOKEN=