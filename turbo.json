{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {},
    "test": {
      "dependsOn": []
    },
    "db:generate": {},
    "db:push": {},
    "db:studio": {}
  },
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL"]
}